<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        CORRECAO (SCA): o parent estava em 3.2.5, versao cujo BOM arrasta
        Spring Framework, Tomcat embarcado e Jackson com CVEs HIGH/CRITICAL.
        Atualizado para a ultima release suportada da linha 3.5.x.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.unifebe.devsecops</groupId>
    <artifactId>banco-facil-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>banco-facil-api</name>
    <description>Aplicacao de demonstracao para atividade de Shift Left / Shift Right</description>

    <properties>
        <java.version>17</java.version>
        <!--
            Sobrescreve a versao do Tomcat embarcado definida pelo BOM do
            Spring Boot, caso o Trivy ainda aponte CVEs em tomcat-embed-core.
        -->
        <tomcat.version>10.1.60</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            CORRECAO (SCA / Log4Shell): a dependencia explicita de
            org.apache.logging.log4j:log4j-core na versao 2.14.1 foi REMOVIDA.
            Ela era vulneravel a CVE-2021-44228 (Log4Shell) e CVE-2021-45046 e
            sequer era necessaria: o PaymentService usa somente a API do log4j
            (LogManager/Logger), que ja vem com o spring-boot-starter-logging
            atraves da ponte log4j-to-slf4j. A implementacao efetiva de log
            continua sendo o Logback, padrao do Spring Boot.
        -->

        <!--
            CORRECAO (higiene de SCA): a dependencia com.google.code.gson:gson
            (declarada duas vezes) foi REMOVIDA. Nenhum arquivo em src/ a
            importava; dependencias nao utilizadas aumentam a superficie de
            ataque e o ruido do inventario/SBOM sem qualquer beneficio.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
